lyen információt vagy segítséget kér a\nfelhasználó az aktuális üzenetben. Ne kizárólag kulcsszavak,\na téma esetleges jogi vonatkozásai vagy a korábbi beszélgetés\nalapján dönts.\n\n\nAz aktuális felhasználói üzenet szándékát osztályozd.\nA history segíthet a kétértelmű üzenetek értelmezésében,\nde nem írhatja felül az egyértelmű témaváltást.', params: PoolingParams(dimensions=None, additional_metadata=None), prompt_token_ids: [42, 2956, 15410, 85727, 5655, 40136, 81, 7061, 4645, 30249, 75, 278, 7751, 264, 296, 3122, 300, 7070, 85727, 67, 86092, 1939, 32, 18027, 329, 266, 12376, 22318, 84, 19003, 285, 18027, 4648, 20308, 19003, 125444, 10489, 5679, 295, 10038, 47580, 74373, 11390, 585, 9544, 1953, 5963, 2643, 11687, 1953, 398, 9510, 93099, 382, 16, 13, 35426, 969, 198, 53, 1953, 14493, 48655, 264, 35426, 969, 595, 1328, 1794, 461, 16685, 11, 6386, 264, 18027, 4648, 20308, 19003, 1794, 30125, 72, 6051, 1953, 5855, 50358, 345, 86353, 301, 82156, 86092, 61532, 17964, 83, 6984, 266, 55403, 595, 13763, 13, 13804, 44815, 9510, 1579, 62932, 507, 1953, 360, 510, 12, 30125, 14357, 370, 1953, 398, 562, 3958, 3342, 301, 82156, 91152, 61532, 57898, 7673, 1370, 93099, 280, 12, 30125, 562, 11, 13040, 15410, 60728, 2576, 963, 709, 74, 21533, 30125, 72, 1152, 273, 75, 16802, 778, 18863, 280, 12, 30708, 16540, 9855, 10302, 3958, 273, 339, 974, 60728, 30125, 72, 18740, 16095, 28882, 325, 280, 12, 30125, 72, 13040, 17115, 440, 31489, 72291, 1225, 11, 30125, 269, 47619, 5524, 11, 8896, 28732, 1953, 8212, 61532, 132642, 81, 28732, 1953, 8212, 655, 73, 41254, 7061, 382, 32, 76438, 6498, 5397, 87923, 6242, 2956, 20308, 2068, 18740, 69, 538, 7673, 1370, 7061, 6850, 374, 76132, 30125, 72, 624, 47, 963, 507, 1953, 360, 25, 14835, 32, 282, 16802, 77, 2956, 73052, 76, 23645, 78211, 6535, 19953, 264, 89451, 1826, 295, 13, 21766, 1013, 13803, 1225, 16218, 17, 13, 4183, 72303, 969, 198, 53, 1953, 14493, 48655, 264, 4183, 72303, 969, 595, 1328, 1794, 461, 16685, 11, 6386, 264, 18027, 4648, 20308,